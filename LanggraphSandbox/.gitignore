# Logs & Serializations
*.log
**/logs/*.log
!**/logs/.gitkeep
logs/
*.dill
*.pkl

# Files directories: ignore all contents but preserve folder structure via .gitkeep
**/files/**
!**/files/
!**/files/**/
!**/files/**/.gitkeep

