# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.ruff_cache/
**/.ruff_cache/
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.coverage
htmlcov/
*.coverage.*

# Virtual environments, OS & IDEs
.venv
.env
.DS_Store
**/.DS_Store
._*
**/._*
.vscode/
.idea/
*.swp
*.swo
*~
.streamlit
chroma_store/
**/chroma_store/
pseudo_store/
faiss_store/
chat_history.txt

# Databases and Local Vector Stores
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
store_*/
store_debug/
db/

# Logs & Serializations
*.log
**/logs/*.log
!**/logs/.gitkeep
logs/
*.dill
*.pkl

# Dynamic Workflow Run Artifacts
**/files/artifacts/*/
!**/files/artifacts/.gitkeep
!**/files/artifacts/catalog.md

# Local scripts
run_tests.sh
clear_cache.sh
